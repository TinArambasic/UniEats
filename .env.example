ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/menza.db
# REQUIRED: postavi sigurni random string (najmanje 32 znaka)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limiter
RATE_LIMITER_BACKEND=memory
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
REDIS_RATE_LIMIT_PREFIX=rl:login

# Optional pickup window (set both to enable)
ORDER_WINDOW_START_HOUR=
ORDER_WINDOW_END_HOUR=

# Logging
LOG_FILE_PATH=
LOG_ROTATION=size
LOG_FILE_MAX_BYTES=10000000
LOG_FILE_BACKUP_COUNT=5
LOG_RETENTION_DAYS=7

# Owner bootstrap (optional)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=Owner
OWNER_LAST_NAME=Account

# Menu image uploads
MENU_IMAGE_UPLOAD_DIR=static/uploads/menu
MENU_IMAGE_MAX_BYTES=3145728
MENU_IMAGE_MAX_WIDTH=2500
MENU_IMAGE_MAX_HEIGHT=2500

# Profile image uploads
PROFILE_IMAGE_UPLOAD_DIR=static/uploads/profiles
PROFILE_IMAGE_MAX_BYTES=3145728
PROFILE_IMAGE_MAX_WIDTH=2500
PROFILE_IMAGE_MAX_HEIGHT=2500

# ISSP SRCE API integration (optional)
# Get credentials from ISSP SRCE: https://isspapi.issp.srce.hr
# If not configured, the student card feature will return a user-friendly
# error message (HTTP 503) instead of crashing. The rest of the system
# continues to work normally without ISSP integration.
ISSP_CLIENT_ID=
ISSP_CLIENT_SECRET=
ISSP_API_BASE_URL=
